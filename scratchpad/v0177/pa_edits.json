 {"file":"src/main/java/com/projecthero/mod/powerarmour/kit/PowerArmourAbilities.java","from":"	/** Every kit hit: the tier's damage, +15% with Overclock. */","to":"	/** v0.17.7 (Street tier) ceilings: a kit hit never goes over its range's top, whatever the suit tier and Overclock. */\n	static float melee(float d) {\n		return Math.min(d, com.projecthero.mod.hero.PowerRank.STREET.meleeMax);\n	}\n\n	static float ability(float d) {\n		return Math.min(d, com.projecthero.mod.hero.PowerRank.STREET.abilityMax);\n	}\n\n	static float ultimate(float d) {\n		return Math.min(d, com.projecthero.mod.hero.PowerRank.STREET.ultimateMax);\n	}\n\n	/** Every kit hit: the tier's damage, +15% with Overclock. */"},
 {"file":"src/main/java/com/projecthero/mod/powerarmour/kit/PowerArmourAbilities.java","from":"		float damage = PowerArmourConfig.PUNCH_DAMAGE * mul(suit) * (1f + charge) * (fist ? PowerArmourConfig.POWER_FIST_MULT : 1f);","to":"		float damage = melee(PowerArmourConfig.PUNCH_DAMAGE * mul(suit) * (1f + PowerArmourConfig.PUNCH_CHARGE_BONUS * charge)\n				* (fist ? PowerArmourConfig.POWER_FIST_MULT : 1f));"},
